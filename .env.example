# 复制为 .env.development(本地开发)或 .env.production(构建)后按需修改
# 注意:Vite 只加载 .env / .env.local / .env.[mode] / .env.[mode].local,
#       本文件(.env.example)仅是模板,不会生效!

# ── 方式 A:直连后端(浏览器跨域,需要后端配好 CORS:允许你的来源 + Allow-Credentials)──
# 填后端完整地址,如 pinggy 隧道:
# VITE_API_BASE=https://xxxx-xx-xx-xx-xx.run.pinggy-free.link
VITE_API_BASE=https://tbjch-109-105-193-135.run.pinggy-free.link


# ── 方式 B:开发代理(推荐本地调试,VITE_API_BASE 留空时生效)──
# dev server 把 /api/* 原样转发到该地址,不存在跨域问题
# VITE_PROXY_TARGET=http://localhost:8080
VITE_PROXY_TARGET=
